{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++ Project",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "$files = Get-ChildItem -Path '${workspaceFolder}' -Filter '*.cpp' -File | ForEach-Object { $_.FullName }; if (-not $files) { Write-Error 'No C++ source files found'; exit 1 }; & cl.exe /nologo /Zi /EHsc '/Fe:${workspaceFolder}\\server.exe' $files; exit $LASTEXITCODE"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
